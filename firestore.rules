rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    // >>> EDIT: lower-case emails of MIRAKI23 administrators who may read every lead and assessment.
    // Keep in sync with the NEXT_PUBLIC_ADMIN_EMAILS GitHub secret/variable.
    function isAdmin() {
      return verified() && request.auth.token.email.lower() in ['admin@miraki23.com'];
    }

    // Lead profile: one document per user (document id = auth uid), written at registration.
    match /leads/{uid} {
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.consentAccepted == true
                    && request.resource.data.email == request.auth.token.email.lower();
      allow read:   if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // Assessments: many per user. Only verified users may create/modify their own.
    match /assessments/{id} {
      allow create: if verified()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'draft';
      allow read:   if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if verified()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
